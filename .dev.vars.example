# Copie para .dev.vars (gitignored) antes de `npm run dev`.
#
# Em localhost não existe Cloudflare Access, então o painel usa um bypass
# de desenvolvimento. Só funciona em localhost/127.0.0.1 e nunca em produção.
ACCESS_DEV_BYPASS=1

# Para testar a validação real do JWT localmente (opcional), desligue o bypass
# acima e preencha os valores da sua Access Application:
# ACCESS_TEAM_DOMAIN=suaequipe
# ACCESS_AUD=aud_tag_da_application
